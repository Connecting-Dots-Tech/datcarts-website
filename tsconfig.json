{
  "compilerOptions": {
    // Module Resolution - Use "bundler" for Next.js
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2017",
    // JSX Settings
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Type Checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    // Module Settings
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // Output Settings
    "noEmit": true,
    "incremental": true,
    "sourceMap": true,
    // Next.js Plugin
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
